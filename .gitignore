# ==========================================
# AgriPulse .gitignore
# ==========================================

# Environments and Secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Machine Learning Models, Checkpoints & Datasets
# Exclude raw data files and binary model weights (track .gitkeep)
ml/**/data/*.csv
ml/**/data/*.xlsx
ml/**/data/*.json
ml/**/data/*.zip
ml/**/data/*.tar.gz
ml/**/model/*.h5
ml/**/model/*.keras
ml/**/model/*.pkl
ml/**/model/*.joblib
ml/**/model/*.pt
ml/**/model/*.pth
ml/**/model/*.onnx
ml/**/results/*.png
ml/**/results/*.jpg
ml/**/results/*.svg
ml/**/results/*.pdf

# Node / Angular
frontend/agripulse-ui/node_modules/
frontend/agripulse-ui/dist/
frontend/agripulse-ui/.angular/
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & Local Volumes
*.sqlite3
*.db
pgdata/
postgres_data/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Always preserve .gitkeep files
!.gitkeep
